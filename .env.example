# CrowdStrike
CS_CLIENT_ID=your-client-id
CS_CLIENT_SECRET=your-client-secret
CS_BASE_URL=https://api.us-2.crowdstrike.com

# Microsoft Defender
DEFENDER_TENANT_ID=your-tenant-id
DEFENDER_CLIENT_ID=your-client-id
DEFENDER_CLIENT_SECRET=your-client-secret

# Qualys
QUALYS_USERNAME=your-username
QUALYS_PASSWORD=your-password
QUALYS_BASE_URL=https://qualysapi.qualys.com

# BindPlane
BINDPLANE_URL=https://your-bindplane-server:3001
BINDPLANE_API_KEY=your-api-key

# Aikido (Application Security)
AIKIDO_CLIENT_ID=
AIKIDO_CLIENT_SECRET=

# Alerting (optional)
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Authentication (Entra ID / Azure AD)
# Set AUTH_ENABLED=true to require Microsoft sign-in
AUTH_ENABLED=false
AUTH_CLIENT_ID=your-app-registration-client-id
AUTH_TENANT_ID=your-entra-tenant-id
AUTH_REDIRECT_URI=http://localhost:8502

# Agent
AGENT_INTERVAL_SECONDS=900
SSL_VERIFY=false
